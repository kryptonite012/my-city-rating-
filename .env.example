# Front end (Vite): URL of the AI proxy. Leave empty to use the built-in offline fallbacks.
# On Vercel the bundled function is served at /api/claude.
VITE_AI_ENDPOINT=/api/claude

# Server-side only (set in your hosting provider's dashboard, never commit a real value).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Optional Express backend (server/)
MONGO_URI=mongodb://localhost:27017/ratemycity
JWT_SECRET=change-me-to-a-long-random-string
